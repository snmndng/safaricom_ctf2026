# Nested unrelated repo (agent framework) — never track
reasonix/

# Vendored third-party CTF skills (ljagiello/ctf-skills, MIT, rev in
# .claude/skills/.upstream-rev). Restore by re-cloning upstream, not from git.
.claude/skills/

# Challenge binaries / large artifacts — keep out of git, track hashes instead
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.iso
*.qcow2
*.vmdk
*.apk
*.apks
*.dex
*.jar
*.bin
*.img
*.pcap
*.pcapng
*.evtx
*.raw
*.dd
*.dmp
*.so
*.elf
*.exe
*.dll

# Never commit captured flags or creds in bulk
flags.local.md
creds.local.*
*.env
.env
!*.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Scratch
/tmp/
scratch/
*.log

# ELF challenge binaries downloaded at runtime (no extension) — keep out of git
chal/pwn/moonbase-radio/receipt

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# agent worktrees + harness-local tool config (regenerable)
.claude/worktrees/
.claude/helpers/
.claude/settings.json
chal/rev/prism-orchestra/receipt

# Project-local third-party tooling, installed skills, and runtime caches
.tools/ctf/
.agents/skills/
.token-optimizer/
